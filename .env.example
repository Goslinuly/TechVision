# ---------------------------------------------------------------------------
# Aqıqat — configuration. Copy to `.env` and fill in.
# The app runs end-to-end with ONLY GOOGLE_FACTCHECK_API_KEY set; everything
# else degrades to a deterministic mock so the pipeline is testable offline.
# ---------------------------------------------------------------------------

# REAL — Google Fact Check Tools API (claims.search). Get a key at
# https://console.cloud.google.com (enable "Fact Check Tools API").
GOOGLE_FACTCHECK_API_KEY=your-google-factcheck-key

# LLM provider: auto | groq | anthropic | mock.
# "auto" prefers Groq (free) if GROQ_API_KEY is set, else Anthropic, else mock.
LLM_PROVIDER=auto

# OPTIONAL — Groq (free tier). Get a key at https://console.groq.com
# When set, the orchestrator runs its agentic tool-use loop on Llama 3.3 70B.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OPTIONAL — Anthropic (paid). When set (and provider=anthropic/auto without a
# Groq key), the Fable 5 loop runs. Otherwise the deterministic mock is used —
# which still calls the real Google + local + rhetoric tools.
ANTHROPIC_API_KEY=
ORCHESTRATOR_MODEL=claude-fable-5
SUBSTEP_MODEL=claude-haiku-4-5

# OPTIONAL — Telegram bot token from @BotFather. When unset, the bot is not
# started; use the HTTP /analyze endpoint or scripts/demo.py instead.
TELEGRAM_BOT_TOKEN=

# Public base URL used to build shareable web-card links (aqiqat.kz/r/xxxx).
PUBLIC_BASE_URL=http://localhost:8000

# OPTIONAL — enable OCR from photos (needs system tesseract with kaz+rus).
ENABLE_OCR=false
